{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "outDir": "./dist"
  },
  "ts-node": {
    "esm": true,
    "experimentalResolver": true
  },
  "include": ["src/**/*", "scratch/**/*"]
}
